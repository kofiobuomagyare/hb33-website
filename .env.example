# ------------------------------------------------------------------
# HB33 website — environment configuration
# Copy this file to `.env.local` and fill in the values for your setup.
# Never commit real secrets. See README.md for details.
# ------------------------------------------------------------------

# Public contact details (visible on the website)
# Primary business email shown on contact pages and used in mailto: links.
NEXT_PUBLIC_CONTACT_EMAIL=hello@hb33.com

# WhatsApp number in international format WITHOUT "+" or spaces, e.g. 15551234567.
# Required for website form submissions. Leave empty only when WhatsApp form
# submission should be disabled; visitors will be asked to try again later.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=CnFZe6AYyYvpUSDHdjWa8VMyt-H3RAMIKK0FwvdmmMk

# Physical / operational base shown in the footer (free text).
NEXT_PUBLIC_COMPANY_LOCATION=West Africa

# Optional: Plausible analytics domain (e.g. hb33.com). The cookieless
# Plausible script loads only after visitors accept the consent banner.
# Leave empty to disable analytics entirely (no banner, no tracking).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Server-side only (never exposed to the browser) -----------------
# Address that receives inquiry notification emails.
INQUIRY_TO_EMAIL=hello@hb33.com

# Optional: Resend API key for transactional email delivery.
# If unset, inquiries are stored server-side and the UI tells the visitor
# honestly that email notification is not configured (with a WhatsApp / email
# fallback) instead of showing a false "email sent" message.
RESEND_API_KEY=

# Optional: generic webhook URL that receives the inquiry JSON via POST.
INQUIRY_WEBHOOK_URL=

# Durable inquiry storage on serverless hosts (Vercel). Upstash Redis /
# Vercel KV REST credentials. Use either pair; both are server-only.
# Without one of these (and without a webhook / email provider) the API
# returns an honest 503 and asks the visitor to resend by email or WhatsApp
# instead of pretending the inquiry was saved.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# INQUIRY_STORE_KEY=hb33:inquiries

# Optional: override the sender address for Resend notifications.
# INQUIRY_FROM_EMAIL=HB33 Website <website@hb33.com>

# Location autocomplete uses Photon (OpenStreetMap search, no API key).
# Optional: point at a self-hosted Photon instance for production volume.
PHOTON_URL=
# Contact address included in the Photon request User-Agent.
LOCATION_SEARCH_EMAIL=hello@hb33.com
